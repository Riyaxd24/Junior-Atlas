# Junior Atlas environment template.
# Copy to .env and fill in values locally. Never commit .env.

# --- Discord (required) ---
DISCORD_TOKEN=
BOT_OWNER_IDS=
# Optional cleanup target for stale guild-scoped slash commands. Commands are
# registered globally; this value is not used to create a second guild copy.
GUILD_ID=
COMMAND_PREFIX=,

# --- PostgreSQL / PgBouncer ---
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/junior_atlas
POSTGRES_USER=junior_atlas
POSTGRES_PASSWORD=
POSTGRES_DB=junior_atlas
# Point DATABASE_URL at PgBouncer's transaction port (6432) in production and enable this.
DB_USE_PGBOUNCER=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=5000

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
CACHE_TTL_SECONDS=600
REDIS_LOCK_TTL_MS=5000

# --- HTTP endpoints ---
METRICS_HOST=127.0.0.1
METRICS_PORT=9100
HEALTH_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# --- Dashboard (deferred; disabled by default) ---
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8081
DASHBOARD_API_KEY=

# --- Greetings ---
GREETING_QUEUE_SIZE=1000
GREETING_WORKERS=4
GREETING_MAX_EVENT_AGE=30

# --- Invite tracking ---
INVITE_JOIN_QUEUE_SIZE=2000
INVITE_STAT_FLUSH_INTERVAL=1.0

# --- Gateway / sharding ---
# In multi-pod mode, each pod MUST have a unique INSTANCE_ID and non-overlapping SHARD_IDS.
SHARD_COUNT=
SHARD_IDS=
INSTANCE_ID=
SHARD_LEASE_TTL_MS=30000
GATEWAY_QUEUE_SIZE=4096
GATEWAY_CRITICAL_QUEUE_SIZE=1024
GATEWAY_WORKERS=4
GATEWAY_GUILD_CONCURRENCY=1
GATEWAY_MAX_EVENT_AGE=10
GATEWAY_DLQ_MAXSIZE=2048
# Graceful shutdown: time allowed for accepted gateway events to drain.
GATEWAY_SHUTDOWN_TIMEOUT=15

# --- Observability ---
LOG_LEVEL=INFO
ENVIRONMENT=development
OTEL_ENABLED=false
OTEL_SERVICE_NAME=junior-atlas
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Optional music provider ---
LAVALINK_URL=
LAVALINK_PASSWORD=

# --- AutoMod ---
# Decaying multi-factor moderation heat.
AUTOMOD_HEAT_DECAY=0.08
AUTOMOD_HEAT_TTL=900
